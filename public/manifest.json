{
    "name": "PocketRisu-SiGNAL",
    "short_name": "SiGNAL",
    "icons": [
        {
            "src": "/web-app-manifest-512x512.png",
            "type": "image/png",
            "sizes": "512x512",
            "purpose": "maskable"
        },
        {
            "src": "/web-app-manifest-192x192.png",
            "type": "image/png",
            "sizes": "192x192",
            "purpose": "maskable"
        }
    ],
    "start_url": "/",
    "display": "standalone",
    "theme_color": "#4682B4",
    "share_target": {
        "action": "/receive-files/",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "files": [
                {
                    "name": "character",
                    "accept": [".charx"]
                },
                {
                    "name": "preset",
                    "accept": [".risup"]
                },
                {
                    "name": "module",
                    "accept": [".risum"]
                }
            ]
        }
    },
    "file_handlers": [
        {
            "action": "/",
            "accept": {
                "application/octet-stream": [".charx", ".risup", ".risum"]
            }
        }
    ]
      
}
